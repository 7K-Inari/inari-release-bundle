{
  "name": "inari-e2e-ui",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright Test suite for the Inari console UI e2e (scripts/e2e/ui).",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --config playwright.config.ci.ts",
    "test:seed": "node --test \"seed/**/*.test.mjs\"",
    "test:flakes": "node --test report-flakes.test.mjs quarantine-issues.test.mjs",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  }
}
