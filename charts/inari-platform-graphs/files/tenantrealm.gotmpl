{{- /* TenantRealm composition body (function-go-templating, Inline source).
     Tokens @@PROVIDER_CONFIG_REF@@ and @@ISSUER_BASE_URL@@ are substituted by
     helm from .Values.keycloak.providerConfigRef / .Values.keycloak.issuerBaseURL
     when templates/keycloak/composition-tenantrealm.yaml renders this file. */ -}}
{{- $xr := .observed.composite.resource -}}
{{- $spec := $xr.spec -}}
{{- $realm := $spec.realm | default $spec.tenantID -}}
---
apiVersion: realm.keycloak.m.crossplane.io/v1alpha1
kind: Realm
metadata:
  # MR name = XR name (always DNS-valid); the realm name lives in
  # forProvider.realm + external-name, so non-DNS realm names can't break
  # the composed resource.
  name: {{ $xr.metadata.name }}
  namespace: {{ $xr.metadata.namespace }}
  annotations:
    # Free-string fields are quoted: spec.realm is not DNS-constrained, so
    # values like "acme: v2" must not break the composed YAML.
    crossplane.io/external-name: {{ $realm | quote }}
    gotemplating.fn.crossplane.io/composition-resource-name: realm
    # XR Ready tracks the composed Realm's Ready condition — the function
    # reports composed resources unready by default; the ready annotation is
    # the only readiness source. Empty on the first pass (nothing observed
    # yet) => False.
    gotemplating.fn.crossplane.io/ready: '{{ $o := index $.observed.resources "realm" }}{{ if $o }}{{ (getResourceCondition "Ready" $o.resource).Status | default "False" }}{{ else }}False{{ end }}'
spec:
  forProvider:
    realm: {{ $realm | quote }}
    {{- if $spec.displayName }}
    displayName: {{ $spec.displayName | quote }}
    {{- end }}
    enabled: {{ $spec.enabled }}
  # Crossplane v2 namespaced MRs have no spec.deletionPolicy — the default
  # managementPolicies already cover the full lifecycle incl. delete (the
  # D7 declarative-recreate semantic: XR deleted → realm deleted).
  providerConfigRef:
    kind: ClusterProviderConfig
    name: @@PROVIDER_CONFIG_REF@@
---
# Patch the composite status: effective realm name + OIDC issuer URL
# (operator contract: issuerURL = <base>/realms/<realm>). No
# composition-resource-name annotation => status-only update of the XR
# (function-go-templating documented behavior).
apiVersion: identity.inari.io/v1alpha1
kind: TenantRealm
status:
  realm: {{ $realm | quote }}
  issuerURL: "@@ISSUER_BASE_URL@@/realms/{{ $realm }}"
